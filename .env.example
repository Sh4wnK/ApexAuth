# ApexAuth server
APEXAUTH_HTTP_ADDR=:8080
APEXAUTH_GRPC_ADDR=:9090
APEXAUTH_BASE_URL=http://localhost:8080
APEXAUTH_LOG_LEVEL=info

# PostgreSQL
APEXAUTH_PG_DSN=postgres://apexauth:apexauth@localhost:5432/apexauth?sslmode=disable

# Redis (set APEXAUTH_CACHE=false to run without Redis and compare latencies)
APEXAUTH_REDIS_ADDR=localhost:6379
APEXAUTH_REDIS_PASSWORD=
APEXAUTH_REDIS_DB=0
APEXAUTH_CACHE=true

# JWT signing: ed25519 (default) or rsa. APEXAUTH_SIGNING_KEY optionally
# points at an existing PEM private key (PKCS#8 / PKCS#1 / EC).
APEXAUTH_SIGN_ALG=ed25519
APEXAUTH_SIGNING_KEY=
APEXAUTH_ROTATE_AFTER=24h

# Token lifetimes
APEXAUTH_ACCESS_TTL=15m
APEXAUTH_REFRESH_TTL=720h
APEXAUTH_SESSION_TTL=720h
APEXAUTH_CODE_TTL=5m
APEXAUTH_PASSWORDLESS_TTL=10m

# Rate limiting (login / OTP / magic-link endpoints)
APEXAUTH_RATE_WINDOW=1m
APEXAUTH_RATE_MAX=10
APEXAUTH_LOGIN_ATTEMPTS=5

# Email
APEXAUTH_EMAIL_FROM=ApexAuth <no-reply@apexauth.local>
APEXAUTH_SMTP_HOST=
APEXAUTH_SMTP_PORT=587
APEXAUTH_SMTP_USERNAME=
APEXAUTH_SMTP_PASSWORD=

# HMAC secret for the browser login cookie (>= 32 chars; required in prod)
APEXAUTH_HMAC_SECRET=

# Seed command
APEXAUTH_SEED_USERS=1000
